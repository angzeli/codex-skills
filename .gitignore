.env
.env.*
!.env.example

# Python caches, environments, and builds
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Node and frontend tooling
node_modules/
.npm/
.yarn/cache/
.pnpm-store/
.parcel-cache/
.next/
.nuxt/
coverage/

# Local execution output
*.tmp
*.log
*.pid
tmp/

# TeX and LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
